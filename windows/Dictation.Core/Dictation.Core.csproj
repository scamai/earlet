<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0, not net9.0-windows. Everything the Windows entry point decides
         (which files it needs, what it tells the user, when a window may
         close, which key it holds) lives here so Dictation.Core.Tests can run
         it on a machine with no Windows in it. Dictation.App keeps only the
         WPF window and the Win32 adapters it hands to this project. -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dictation.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings Dictation.Speech (the worker host and push-to-talk
         controller) and the logging abstractions with it. -->
    <ProjectReference Include="../Dictation.Services/Dictation.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- DictationController.Pause: the teardown behind TryPause, which the
         app never calls directly. The tests do, to reach the teardown of a
         dictation under way. -->
    <InternalsVisibleTo Include="Dictation.Core.Tests" />
  </ItemGroup>

</Project>
